<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>RIO - Chequeo Médico</display-name>

  <!-- Filtro de encoding UTF-8 -->
  <filter>
    <filter-name>EncodingFilter</filter-name>
    <filter-class>com.rio.chequeo.util.EncodingFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>EncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- ==================== SERVLETS ==================== -->

  <!-- Auth -->
  <servlet>
    <servlet-name>AuthServlet</servlet-name>
    <servlet-class>com.rio.chequeo.controller.AuthServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AuthServlet</servlet-name>
    <url-pattern>/auth</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AuthServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AuthServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- Patients -->
  <servlet>
    <servlet-name>PatientServlet</servlet-name>
    <servlet-class>com.rio.chequeo.controller.PatientServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PatientServlet</servlet-name>
    <url-pattern>/patients</url-pattern>
  </servlet-mapping>

  <!-- Sheet (formulario de hojas) -->
  <servlet>
    <servlet-name>SheetServlet</servlet-name>
    <servlet-class>com.rio.chequeo.controller.SheetServlet</servlet-class>
    <multipart-config>
      <!-- Máximo 20MB por imagen (portadas y membretes en alta resolución) -->
      <max-file-size>20971520</max-file-size>
      <max-request-size>20971520</max-request-size>
      <file-size-threshold>1048576</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>SheetServlet</servlet-name>
    <url-pattern>/sheet</url-pattern>
  </servlet-mapping>

  <!-- Doctors -->
  <servlet>
    <servlet-name>DoctorServlet</servlet-name>
    <servlet-class>com.rio.chequeo.controller.DoctorServlet</servlet-class>
    <multipart-config>
      <max-file-size>5242880</max-file-size>
      <max-request-size>5242880</max-request-size>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>DoctorServlet</servlet-name>
    <url-pattern>/doctors</url-pattern>
  </servlet-mapping>

  <!-- PDF export -->
  <servlet>
    <servlet-name>PDFServlet</servlet-name>
    <servlet-class>com.rio.chequeo.controller.PDFServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PDFServlet</servlet-name>
    <url-pattern>/pdf</url-pattern>
  </servlet-mapping>

  <!-- ==================== SESIÓN ==================== -->
  <session-config>
    <session-timeout>60</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>

  <!-- ==================== WELCOME ==================== -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- ==================== ERROR PAGES ==================== -->
  <error-page>
    <error-code>403</error-code>
    <location>/auth</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>

  <!-- ==================== JNDI DATA SOURCE ==================== -->
  <resource-ref>
    <description>Oracle DataSource para RIO Chequeo Médico</description>
    <res-ref-name>jdbc/ChequeoDS</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

</web-app>
